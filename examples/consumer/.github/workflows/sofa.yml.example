# Copy to .github/workflows/sofa.yml in the designated disposable repository.
# Use after Kevin merges Sofa and the first v0 release is promoted.
# Each CLI-using job independently selects the currently promoted v0 release.
name: sofa disposable canary

on:
  workflow_dispatch:
    inputs:
      issue_number:
        description: Approved issue number in this repository
        required: true
        type: number
      version:
        description: Optional exact immutable v0 release (empty selects the current promotion)
        required: false
        type: string

permissions: {}

# Serialize the same issue; admission still checks the persisted attempt fence.
concurrency:
  group: sofa-${{ github.repository }}-${{ inputs.issue_number }}
  cancel-in-progress: false

jobs:
  reconcile:
    name: Admit or recover approved issue
    if: github.event.repository.fork == false && github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    permissions:
      contents: write
      actions: read
    uses: kevinmartin/sofa/.github/workflows/reconcile.reusable.yml@v0
    with:
      issue_number: ${{ fromJSON(inputs.issue_number) }}
      version: ${{ inputs.version }}
    secrets:
      SOFA_PROJECTS_TOKEN: ${{ secrets.SOFA_PROJECTS_TOKEN }}

  # Idle/completed admission stops here without consuming model inference.
  work:
    name: Execute, verify, and publish draft candidate
    needs: reconcile
    if: needs.reconcile.outputs.dispatch == 'true'
    permissions:
      contents: write
      copilot-requests: write
      actions: read
    uses: kevinmartin/sofa/.github/workflows/work.reusable.yml@v0
    with:
      version: ${{ inputs.version }}
      reconcile_publication: ${{ needs.reconcile.outputs.reconcile_publication == 'true' }}
      reconcile_candidate: ${{ needs.reconcile.outputs.reconcile_candidate == 'true' }}
    secrets:
      SOFA_PROJECTS_TOKEN: ${{ secrets.SOFA_PROJECTS_TOKEN }}
      SOFA_PUBLISH_TOKEN: ${{ secrets.SOFA_PUBLISH_TOKEN }}
      SOFA_PUBLISH_APP_ID: ${{ secrets.SOFA_PUBLISH_APP_ID }}
      SOFA_PUBLISH_APP_PRIVATE_KEY: ${{ secrets.SOFA_PUBLISH_APP_PRIVATE_KEY }}
